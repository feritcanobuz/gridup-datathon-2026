    "#C9405C",
    "#F2B134",
    "#6C5CE7",
    "#2D9CDB"
  ],
  "background": "#F3F5F8",
  "foreground": "#1E2A38",
  "tableAccent": "#2E5EAA",
  "good": "#3BA99C",
