        "header": [
          {
            "show": true,
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#E6EAF0"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E2A38"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ]
      }
